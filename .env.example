# Copy to .env and fill in real values. Never commit .env.

# Anthropic (Claude API) — required
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Embeddings — local sentence-transformers model, no token required
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Streamlit demo
POLICY_AGENT_PORT=8501

# Logging
LOG_LEVEL=info

# Retrieval
RETRIEVAL_TOP_K=8

# Auth - random secret used to sign the login session cookie. Generate one
# with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_KEY=

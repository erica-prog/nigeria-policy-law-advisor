# Copy to .env and fill in real values. Never commit .env.

# Anthropic (Claude API) — the SERVER's key. Used by
# the ingestion scripts and the eval harness. Web app users bring their own
# key (docs/17-web-app-mvp.md, "Bring your own Claude key"); this one is used
# for them only when ALLOW_SHARED_ANTHROPIC_KEY=true below. The web API starts
# without it and reports llm_configured=false on /api/health.
# This file must be named `.env` and live in the repository root, next to
# pyproject.toml. Restart the server after editing it. An exported but EMPTY
# shell variable (`export ANTHROPIC_API_KEY=`) is ignored, so it cannot hide
# the value below; a non-empty shell variable still takes precedence.
# Docker: docker-compose.yml passes this file through `env_file: .env`.
ANTHROPIC_API_KEY=
# Only when the key above is an organization key that is not scoped to one
# workspace. Anthropic then rejects the call unless this id is sent as the
# anthropic-workspace-id header. Leave blank for a workspace-scoped key.
# A user's own key never receives this value.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Embeddings — local sentence-transformers model, no token required.
# Changing this after building the index makes the app refuse to search until
# the embeddings are rebuilt: vectors from two models aren't comparable.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Supabase Postgres: matters, chunks with their embeddings, and chat history.
# Dashboard > Connect > Session pooler (port 5432) - it works over IPv4, which
# the direct connection does not without a paid add-on. It contains your
# database password: keep it in .env or a secret store, never in git or logs.
DATABASE_URL=

# Logging
LOG_LEVEL=info

# Retrieval
RETRIEVAL_TOP_K=8
# Two-band relevance gate on cosine distance. At or below CERTAIN the matter
# clearly covers the question; above MAX it clearly doesn't, and retrieval
# returns nothing so the official-sources fallback can fire. In between, one
# small Claude call decides. Calibrate with
# `uv run python -m eval.calibrate_relevance_floor`.
# Set CERTAIN >= MAX for a plain threshold with no extra call; MAX=2.0 disables.
# MAX is deliberately loose: it only buys cheap rejection of the obviously
# unrelated, because distances in a lawyer's own matter sit much higher than in
# the demo corpus. The middle-band adjudicator is the real classifier.
# Up to this many chunks a matter is keyword-searched with an in-memory BM25
# index; above it, Postgres full-text search is used (0 forces full-text search).
KEYWORD_INDEX_MAX_CHUNKS=5000
RETRIEVAL_CERTAIN_DISTANCE=0.21
RETRIEVAL_MAX_DISTANCE=0.50

# Auth - random secret used to sign the web API's login session cookie
# and to derive the encryption key for users' stored Claude keys.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# The web API refuses to store user keys while this is unset/default. Rotating
# it logs everyone out and makes them paste their Claude key again.
AUTH_COOKIE_KEY=

# Web API (docs/17-web-app-mvp.md)
# Set true when served over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_MB=25
# Where uploaded originals are kept (one folder per matter). Inside data/ so the
# container's data volume persists it; an S3-compatible store is the planned alternative.
ORIGINALS_DIR=data/originals
# Document jobs are rows in the database. true: the API process ingests uploads
# itself. false: run `uv run python -m policy_advisor.worker` alongside the API.
INLINE_WORKERS=true
# Let web users WITHOUT a Claude key of their own use ANTHROPIC_API_KEY above
# (you pay for their questions). Default false: each user brings their own
# key and gets "Activate the advisor" until they do.
ALLOW_SHARED_ANTHROPIC_KEY=false
# Per-chunk Claude translation during ingestion. false = offline uploads
# (language is still detected; nothing is translated).
TRANSLATE_ON_INGEST=true

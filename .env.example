# Copy to .env and fill in real values. Never commit .env.

# Anthropic (Claude API) — required for answers, analysis and ingestion-time
# translation. The web API still starts without it and reports
# llm_configured=false on /api/health.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Embeddings — local sentence-transformers model, no token required
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Streamlit demo
POLICY_AGENT_PORT=8501

# Logging
LOG_LEVEL=info

# Retrieval
RETRIEVAL_TOP_K=8

# Auth - random secret used to sign the login session cookie (Streamlit and
# the web API). Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_KEY=

# Web API (docs/17-web-app-mvp.md)
# Set true when served over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_MB=25
# Per-chunk Claude translation during ingestion. false = offline uploads
# (language is still detected; nothing is translated).
TRANSLATE_ON_INGEST=true
